== name: graphic overtypes by default
-- file a.txt
abc
-- args a.txt
-- keys
"xy"
-- expect file a.txt
xyc
-- expect cursor 0 2
-- expect result true

== name: graphic inserts in insert mode
-- file a.txt
abc
-- args a.txt
-- keys
insertmode "xy"
-- expect file a.txt
xyabc

== name: insertmode toggles and returns the new state
-- keys
insertmode
-- expect result true
-- keys
insertmode
-- expect result false

== name: insertmode rejects an argument
-- keys
arg insertmode
-- expect message Invalid argument

== name: graphic pads virtual space and adds lines
-- file a.txt
ab
-- args a.txt
-- keys
down down right right right "z"
-- expect file a.txt
ab

   z

== name: graphic expands tabs of the edited line only
-- file a.txt
\tx
\ty
-- args a.txt
-- keys
right "z"
-- expect file a.txt
 z      x
\ty

== name: graphic overtypes a wide character as a whole
-- file a.txt
日本
-- args a.txt
-- keys
"a"
-- expect file a.txt
a本
-- expect cursor 0 1

== name: graphic types a wide character
-- keys
insertmode "日x"
-- expect cursor 0 3

== name: graphic assigned to a control key inserts its code
-- tools.ini
[mep]
graphic:ctrl+l
-- keys
ctrl+l
-- expect file <untitled> noeol
\f

== name: graphic by name without a key does nothing
-- keys
graphic
-- expect result false

== name: graphic with an argument from a macro is invalid
-- tools.ini
[mep]
typex:=arg "a" graphic
-- keys
typex
-- expect message Invalid argument

== name: wordwrap breaks at the last blank before the margin
-- tools.ini
[mep]
wordwrap:
rmargin:10
-- keys
insertmode "  hello world"
-- expect file <untitled> noeol
  hello
  world
-- expect cursor 1 7

== name: wordwrap does not break a word without a blank
-- tools.ini
[mep]
wordwrap:
rmargin:4
-- keys
insertmode "abcdefg"
-- expect file <untitled> noeol
abcdefg

== name: quote inserts the next key literally
-- keys
quote
-- expect waiting
-- keys
esc
-- expect file <untitled> noeol
\e
-- keys
quote f2
-- expect file <untitled> noeol
\e

== name: quote with an argument is invalid
-- keys
arg quote
-- expect message Invalid argument

== name: cdelete in overtype mode blanks the previous character
-- file a.txt
abc
-- args a.txt
-- keys
right right cdelete
-- expect file a.txt
a c
-- expect cursor 0 1

== name: cdelete in insert mode deletes it
-- file a.txt
abc
-- args a.txt
-- keys
insertmode right right cdelete
-- expect file a.txt
ac

== name: cdelete beyond the line end moves to the end
-- file a.txt
ab
-- args a.txt
-- keys
right right right right right cdelete
-- expect cursor 0 2
-- expect file a.txt
ab

== name: cdelete at column 0 moves to the previous line end
-- file a.txt
ab
cd
-- args a.txt
-- keys
down cdelete
-- expect cursor 0 2
-- keys
meta begline cdelete
-- expect result false

== name: cdelete with a nullarg is invalid
-- keys
arg cdelete
-- expect message Invalid argument

== name: cdelete blanks a wide character in overtype mode
-- file a.txt
日x
-- args a.txt
-- keys
right cdelete
-- expect file a.txt
  x

== name: emacscdel joins lines in insert mode
-- file a.txt
ab
cd
-- args a.txt
-- keys
insertmode down emacscdel
-- expect file a.txt
abcd
-- expect cursor 0 2

== name: emacscdel beyond the file moves up in insert mode
-- file a.txt
ab
-- args a.txt
-- keys
insertmode down down emacscdel
-- expect cursor 1 0
-- expect file a.txt
ab

== name: emacscdel in overtype mode acts like cdelete
-- file a.txt
ab
cd
-- args a.txt
-- keys
down emacscdel
-- expect cursor 0 2
-- expect file a.txt
ab
cd

== name: emacscdel edits the text argument
-- keys
arg "abc" emacscdel ldelete
-- expect message Invalid argument

== name: emacsnewl in overtype mode only moves
-- file a.txt
abc
-- args a.txt
-- keys
right emacsnewl
-- expect cursor 1 0
-- expect file a.txt
abc

== name: emacsnewl in insert mode splits the line with indentation
-- file a.txt
  ab cd
-- args a.txt
-- keys
insertmode right right right right right emacsnewl
-- expect file a.txt
  ab 
  cd
-- expect cursor 1 2

== name: meta emacsnewl splits without indentation
-- file a.txt
  abcd
-- args a.txt
-- keys
insertmode right right right right meta emacsnewl
-- expect file a.txt
  ab
cd

== name: emacsnewl beyond the file adds lines
-- file a.txt crlf
a
-- args a.txt
-- keys
insertmode down down emacsnewl
-- expect file a.txt crlf
a
~
~
~
== name: sdelete deletes the character under the cursor
