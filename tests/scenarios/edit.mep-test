== name: undo reverses the last change and restores the cursor
-- file a.txt
abc
-- args a.txt
-- keys
right "xy" right undo
-- expect file a.txt
axc
-- expect cursor 0 2
-- expect result true

== name: undo goes back step by step and stops when empty
-- file a.txt
abc
-- args a.txt
-- keys
"x" "y" undo
-- expect file a.txt
xbc
-- keys
undo undo
-- expect file a.txt
abc

== name: undocount limits the steps
-- tools.ini
[mep]
undocount:1
-- file a.txt
abc
-- args a.txt
-- keys
"x" "y" undo undo
-- expect file a.txt
xbc

== name: undocount 0 keeps nothing
-- tools.ini
[mep]
undocount:0
-- file a.txt
abc
-- args a.txt
-- keys
insertmode emacsnewl undo
-- expect file a.txt
~
abc

== name: a macro is one undo step
