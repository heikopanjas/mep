== name: argcol past the end of the file does not run away
-- file a.txt
alpha
beta
-- args a.txt
-- keys
down down down down argcol down down down copy
-- expect clipboard stream
~

== name: shift+down through the owner's macro reaches argcol
-- tools.ini
[mep]
Selectdown:=Argcol Down
Selectdown:Shift+Down
-- file a.txt
alpha
beta
gamma
-- args a.txt
-- keys
right right shift+down shift+down copy
-- expect clipboard stream
pha
beta
ga
