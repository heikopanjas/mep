== name: quitting writes the information file, the current file first
-- env XDG_CONFIG_HOME=/cfg
-- file /cfg/mep/mep.tmp
/work/a.txt\t9\t9\t9\t9
bad line
\t1\t2\t3\t4
/x.txt\ta\t1\t1\t1
/old.txt\t2\t0\t0\t0
-- file a.txt
l0
l1
l2
l3
l4
l5
l6
-- file b.txt
b0
b1
-- args a.txt
-- size 20 14
-- keys
down down down down down down arg window arg "b.txt" setfile down exit
-- expect quit
-- expect disk /cfg/mep/mep.tmp
/work/b.txt\t1\t0\t0\t0
/work/a.txt\t5\t0\t0\t0
/old.txt\t2\t0\t0\t0

== name: a file no longer shown keeps its last position; tmpsav limits the list
-- env HOME=/home
-- tools.ini
[mep]
tmpsav:2
-- file /home/.config/mep/mep.tmp
/old.txt\t2\t0\t0\t0
-- file a.txt
a0
a1
-- file b.txt
b
-- args a.txt
-- keys
down right arg "b.txt" setfile exit
-- expect disk /home/.config/mep/mep.tmp
/work/b.txt\t0\t0\t0\t0
/work/a.txt\t1\t1\t0\t0

== name: temporary sessions and tmpsav 0 write nothing
-- env XDG_CONFIG_HOME=/cfg
-- temporary
-- file /cfg/mep/mep.tmp
/old.txt\t2\t0\t0\t0
-- file a.txt
a
-- args a.txt
-- keys
exit
-- expect quit
-- expect disk /cfg/mep/mep.tmp
/old.txt\t2\t0\t0\t0

== name: tmpsav 0 writes nothing
-- env XDG_CONFIG_HOME=/cfg
-- tools.ini
[mep]
tmpsav:0
-- file /cfg/mep/mep.tmp
/old.txt\t2\t0\t0\t0
-- file a.txt
a
-- args a.txt
-- keys
exit
-- expect disk /cfg/mep/mep.tmp
/old.txt\t2\t0\t0\t0

== name: a failed write is ignored
-- env XDG_CONFIG_HOME=/cfg
-- fail createdir /cfg/mep
-- keys
exit
-- expect quit

== name: closing the terminal writes the information file
-- os windows
-- env APPDATA=/data
-- file a.txt
a
-- args a.txt
-- close
-- expect quit
-- expect disk /data/mep/mep.tmp
\work\a.txt\t0\t0\t0\t0

== name: confirmed exit writes the information file
-- env XDG_CONFIG_HOME=/cfg
-- file a.txt
a
-- args a.txt
-- keys
"x" arg "<untitled>" setfile "y" arg "a.txt" setfile meta exit "y"
-- expect quit
-- expect disk /cfg/mep/mep.tmp
/work/a.txt\t0\t1\t0\t0

== name: starting without files reopens the last file at its position
-- env XDG_CONFIG_HOME=/cfg
-- file /cfg/mep/mep.tmp
/work/a.txt\t1\t2\t0\t0
-- file a.txt
a0
a1
-- expect current a.txt
-- expect cursor 1 2

== name: a last file that is gone leaves the untitled buffer
-- env XDG_CONFIG_HOME=/cfg
-- file /cfg/mep/mep.tmp
/work/gone.txt\t1\t2\t0\t0
-- expect current <untitled>
-- expect cursor 0 0

== name: a missing information file starts empty
-- env XDG_CONFIG_HOME=/cfg
-- expect current <untitled>

== name: opening a remembered file restores its position
-- env XDG_CONFIG_HOME=/cfg
-- file /cfg/mep/mep.tmp
/work/a.txt\t3\t1\t2\t0
-- file a.txt
a0
a1
a2
a3
-- file c.txt
c
-- args c.txt
-- keys
arg "a.txt" setfile
-- expect current a.txt
-- expect cursor 3 1
-- expect window 2 0

== name: information lists open and remembered files and setfile opens a line
-- env XDG_CONFIG_HOME=/cfg
-- file /cfg/mep/mep.tmp
/work/a.txt\t0\t0\t0\t0
/work/b.txt\t0\t0\t0\t0
-- file a.txt
a0
a1
-- file b.txt
b
-- args a.txt
-- keys
information
-- expect result true
-- expect current <information>
-- expect file <information>
/work/a.txt  Length=2
/work/b.txt
-- keys
down arg setfile
-- expect current b.txt
-- keys
information
-- expect file <information>
/work/a.txt  Length=2
/work/b.txt  Length=1

== name: information takes no argument
-- keys
arg information
-- expect message Invalid argument
-- expect result false
