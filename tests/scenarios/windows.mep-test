== name: setfile in a window keeps the other and switching back restores the position
-- size 20 14
-- file a.txt
l0
l1
l2
l3
l4
l5
l6
-- file b.txt
b
-- args a.txt
-- keys
down down down down down down arg window arg "b.txt" setfile
-- expect current b.txt
-- keys
window
-- expect current a.txt
-- expect cursor 5 0
-- keys
window arg "a.txt" setfile
-- expect cursor 6 0
-- expect window 6 0

