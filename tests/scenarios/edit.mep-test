-- expect file a.txt
f(a[b]) 
-- expect result true

== name: meta pbal only highlights
-- file a.txt
{x
-- args a.txt
-- keys
endline meta pbal
-- expect file a.txt
{x
-- expect result true

== name: arg pbal scans forward for an unbalanced closing bracket
-- file a.txt
x a)]
-- args a.txt
-- keys
insertmode arg pbal
-- expect file a.txt
(x a)]

== name: pbal without an unbalanced bracket fails
